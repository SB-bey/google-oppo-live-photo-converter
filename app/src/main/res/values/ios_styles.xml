<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- iOS 主按钮：蓝色填充、12dp 圆角、无阴影、加粗文字 -->
    <style name="iOSFilledButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ios_blue_fill</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- iOS 次要按钮：浅蓝底、蓝字 -->
    <style name="iOSTintedButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ios_blue_tint_light</item>
        <item name="android:textColor">@color/ios_blue_text_light</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 深色模式下的 iOS 次要按钮 -->
    <style name="iOSTintedButtonDark" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ios_blue_tint_dark</item>
        <item name="android:textColor">@color/ios_blue_text_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- iOS 分段控件按钮（UISegmentedControl 风格） -->
    <style name="iOSSegmentButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ios_segment_btn_bg</item>
        <item name="android:textColor">@color/ios_segment_btn_text</item>
        <item name="cornerRadius">7dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- iOS 图标按钮 -->
    <style name="iOSIconButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="backgroundTint">@color/ios_icon_btn_bg</item>
        <item name="iconTint">@color/ios_icon_btn_fg</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
