<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 公共基础：iOS 风格浅色主题 + 沉浸式系统栏 -->
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- iOS 蓝（默认） -->
    <style name="AppTheme" parent="AppThemeBase">
        <item name="colorPrimary">@color/md_light_primary</item>
        <item name="colorOnPrimary">@color/md_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_light_secondary</item>
        <item name="colorOnSecondary">@color/md_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_light_error</item>
        <item name="colorOnError">@color/md_light_onError</item>
        <item name="android:colorBackground">@color/md_light_background</item>
        <item name="colorSurface">@color/md_light_surface</item>
        <item name="colorOnSurface">@color/md_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_light_outline</item>
        <item name="colorOutlineVariant">@color/md_light_outlineVariant</item>
    </style>

    <!-- iOS 紫 -->
    <style name="AppThemePurple" parent="AppThemeBase">
        <item name="colorPrimary">@color/md_purple_primary</item>
        <item name="colorOnPrimary">@color/md_purple_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_purple_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_purple_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_purple_secondary</item>
        <item name="colorOnSecondary">@color/md_purple_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_purple_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_purple_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_purple_tertiary</item>
        <item name="colorOnTertiary">@color/md_purple_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_purple_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_purple_onTertiaryContainer</item>
    </style>

    <!-- iOS 绿 -->
    <style name="AppThemeGreen" parent="AppThemeBase">
        <item name="colorPrimary">@color/md_green_primary</item>
        <item name="colorOnPrimary">@color/md_green_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_green_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_green_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_green_secondary</item>
        <item name="colorOnSecondary">@color/md_green_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_green_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_green_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_green_tertiary</item>
        <item name="colorOnTertiary">@color/md_green_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_green_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_green_onTertiaryContainer</item>
    </style>

    <!-- iOS 粉 -->
    <style name="AppThemePink" parent="AppThemeBase">
        <item name="colorPrimary">@color/md_pink_primary</item>
        <item name="colorOnPrimary">@color/md_pink_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_pink_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_pink_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_pink_secondary</item>
        <item name="colorOnSecondary">@color/md_pink_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_pink_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_pink_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_pink_tertiary</item>
        <item name="colorOnTertiary">@color/md_pink_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_pink_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_pink_onTertiaryContainer</item>
    </style>

    <!-- 跟随系统：iOS 语言下等同默认 iOS 蓝 -->
    <style name="AppThemeDynamic" parent="AppTheme" />
</resources>
